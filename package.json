{
  "name": "lazi-trail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lazi Trail - a 3D endless runner through South African streets, built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "assets": "node tools/fetch-assets.mjs",
    "icons": "node tools/make-icons.mjs",
    "check": "tsc --noEmit && eslint . && vitest run"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "adm-zip": "^0.6.1",
    "eslint": "^10.11.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.2.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "author": "Lazarus Chitsuro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chitsurolazarus-alt/lazi-trail.git"
  },
  "homepage": "https://github.com/chitsurolazarus-alt/lazi-trail#readme",
  "keywords": [
    "game",
    "threejs",
    "endless-runner",
    "typescript",
    "vite",
    "pwa"
  ],
  "engines": {
    "node": ">=20"
  }
}
